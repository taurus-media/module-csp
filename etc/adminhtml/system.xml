<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="csp">
            <group id="whitelist" translate="label" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Whitelist</label>
                <field id="domains" translate="label" type="textarea" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Trusted Domains</label>
                    <comment>One domain per line. Wildcards allowed (E.g.: *.google.com)</comment>
                </field>
            </group>
        </section>
    </system>
</config>
